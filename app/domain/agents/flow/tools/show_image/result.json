{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "native.flow.tool.show_image.result.v1",
  "title": "show_image result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "path",
    "display_url",
    "mime",
    "byte_size",
    "error",
    "source_filename",
    "display_name",
    "source_known",
    "source_ambiguous"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "not_found", "invalid_path", "not_image", "too_large", "error"]
    },
    "path": { "type": ["string", "null"] },
    "display_url": { "type": ["string", "null"] },
    "mime": { "type": ["string", "null"] },
    "byte_size": { "type": ["integer", "null"], "minimum": 0 },
    "error": { "type": ["string", "null"] },
    "source_filename": { "type": ["string", "null"] },
    "display_name": { "type": ["string", "null"] },
    "source_known": { "type": "boolean" },
    "source_ambiguous": { "type": "boolean" },
    "alternate_source_filenames": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
