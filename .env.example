# Native Knowledge Flow — secret içermeyen örnek.
# Kopyalayın: cp .env.example .env
# Yerel geliştirmede AUTH_DISABLED=1 yapın (bypass user/customer id ile).

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/NATIVE_FLOW

# Konuşma belleği / migration betikleri: DATABASE_URL öncelikli.
# DATABASE_URL yoksa POSTGRES_* zorunlu (sessiz default yok).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=NATIVE_FLOW
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

AIRA_DEV_HOST=127.0.0.1
AIRA_DEV_PORT=5000

# JWT / auth. Örnek dosyayı kopyalamak auth'u kapatmaz (AUTH_DISABLED=0).
AUTH_DISABLED=0
AUTH_BYPASS_USER_ID=1
AUTH_BYPASS_CUSTOMER_ID=1
# Auth açıkken zorunlu — provider'ın gerçek login URL'si (/login varsayılmaz).
LOGIN_UI_URL=https://auth.example.invalid/your-real-login-path
AUTH_PROVIDER_URL=https://auth.example.invalid
AUTH_PROVIDER_INTERNAL_URL=
AUTH_SITE_SLUG=airacoder
JWT_ACCEPTED_SITE_SLUGS=airacoder

# Native Flow modeli.
KNOWLEDGE_FLOW_LLM_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_FLOW_LLM_MODEL=gpt-6-luna
KNOWLEDGE_FLOW_LLM_API_KEY=
KNOWLEDGE_FLOW_LLM_TIMEOUT_SECONDS=75
# Yerel Ollama (/api/chat) için zorunlu — kodda numeric/bool fallback yok.
# Cloud OpenAI yolunda CONTEXT/THINK yok sayılır; MAX_OUTPUT_TOKENS varsa max_tokens olur.
# num_ctx /v1 options ile etkili değildir; native transport veya Modelfile kullanın.
KNOWLEDGE_FLOW_LLM_CONTEXT_TOKENS=65536
KNOWLEDGE_FLOW_LLM_MAX_OUTPUT_TOKENS=2048
KNOWLEDGE_FLOW_LLM_THINK=false
# OPENAI_API_KEY yalnız KNOWLEDGE_FLOW_LLM_API_KEY boşsa yedek olarak okunur.
OPENAI_API_KEY=

# Legacy shared corpus path (migration source only — authenticated runs use tenant corpus).
AGENT_CORPUS_DIR=data/corpus
# Per-tenant originals + derived corpus: data/tenants/<customer_id>/{uploads,corpus}
TENANT_DATA_ROOT=data/tenants
# Propose idempotency: processing timeout (saniye); timed-out kayıt otomatik rerun edilmez.
AGENT_SUBMISSION_TIMEOUT_SECONDS=900

# A03 run budgets (zorunlu; geçersiz/eksik değer sessizce fallback edilmez).
# AGENT_SUBMISSION_TIMEOUT_SECONDS çalışan agent'ı kesmez — run deadline ayrıdır.
AGENT_MAX_STEPS=8
AGENT_RUN_TIMEOUT_SECONDS=180
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_MAX_OBSERVATION_BYTES=65536
AGENT_MAX_CONTEXT_BYTES=131072
AGENT_MAX_TOOL_RETRIES=1

# Conversation memory embeddings — tek profil (OpenAI/nomic fallback yok).
# Model doğal boyutu 2560; API dimensions=1536 ile vector(1536) kolonuna uyum.
KNOWLEDGE_FLOW_EMBED_BASE_URL=http://127.0.0.1:11434
KNOWLEDGE_FLOW_EMBED_MODEL=qwen3-embedding:4b
KNOWLEDGE_FLOW_EMBED_DIMENSIONS=1536
KNOWLEDGE_FLOW_EMBED_TIMEOUT_SECONDS=8
# OLLAMA_BASE_URL yalnız KNOWLEDGE_FLOW_EMBED_BASE_URL boşsa yedek okunur.
OLLAMA_BASE_URL=http://127.0.0.1:11434
