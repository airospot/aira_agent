# Native Knowledge Flow — secret içermeyen örnek.
# Kopyalayın: cp .env.example .env

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/NATIVE_FLOW

# Konuşma belleği migration betikleri bu değişkenleri de okur.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=NATIVE_FLOW
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

AIRA_DEV_HOST=127.0.0.1
AIRA_DEV_PORT=5000

# JWT. Boş bırakılırsa security.py varsayılanı auth.airaintelligence.ai olur.
AUTH_PROVIDER_URL=https://auth.example.invalid
AUTH_PROVIDER_INTERNAL_URL=
AUTH_SITE_SLUG=airacoder
JWT_ACCEPTED_SITE_SLUGS=airacoder

# Native Flow modeli. AI_SQL_* okunmaz.
KNOWLEDGE_FLOW_LLM_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_FLOW_LLM_MODEL=gpt-6-luna
KNOWLEDGE_FLOW_LLM_API_KEY=
KNOWLEDGE_FLOW_LLM_TIMEOUT_SECONDS=75
# OPENAI_API_KEY yalnız KNOWLEDGE_FLOW_LLM_API_KEY boşsa yedek olarak okunur.
OPENAI_API_KEY=

# Boş allowlist = CONFIG akışı ve live query kapalı (fail-closed).
KNOWLEDGE_FLOW_CONFIG_CORPUS_CUSTOMER_ALLOWLIST=
KNOWLEDGE_FLOW_LIVE_QUERY_CUSTOMER_ALLOWLIST=

# Anlamsal yeniden sıralama aracı. Ulaşılamazsa araç source_unavailable döner.
RERANK_BASE_URL=http://127.0.0.1:18081

# database_live_query — SQL Server, pyodbc ve ODBC Driver 17/18.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_QUERY_USER=aira_query_reader
SQLSERVER_QUERY_PASSWORD=
SQLSERVER_USER=aira_catalog_reader
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_CONNECT_TIMEOUT=5
SQLSERVER_QUERY_TIMEOUT=30

# İsteğe bağlı anlamsal uzun süreli bellek (memory_service içindeki embedding çağrısı).
# MEMORY_STRUCTURED_ENABLED=0
