# Native Knowledge Flow — secret içermeyen örnek.
# Kopyalayın: cp .env.example .env
# Yerel geliştirmede AUTH_DISABLED=1 yapın (bypass user/customer id ile).

SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/NATIVE_FLOW

# Konuşma belleği / migration betikleri: DATABASE_URL öncelikli.
# DATABASE_URL yoksa POSTGRES_* zorunlu (sessiz default yok).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=NATIVE_FLOW
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD

AIRA_DEV_HOST=127.0.0.1
AIRA_DEV_PORT=5000

# JWT / auth. Örnek dosyayı kopyalamak auth'u kapatmaz (AUTH_DISABLED=0).
AUTH_DISABLED=0
AUTH_BYPASS_USER_ID=1
AUTH_BYPASS_CUSTOMER_ID=1
# Auth açıkken zorunlu — provider'ın gerçek login URL'si (/login varsayılmaz).
LOGIN_UI_URL=https://auth.example.invalid/your-real-login-path
AUTH_PROVIDER_URL=https://auth.example.invalid
AUTH_PROVIDER_INTERNAL_URL=
AUTH_SITE_SLUG=airacoder
JWT_ACCEPTED_SITE_SLUGS=airacoder

# Native Flow modeli.
KNOWLEDGE_FLOW_LLM_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_FLOW_LLM_MODEL=gpt-6-luna
KNOWLEDGE_FLOW_LLM_API_KEY=
KNOWLEDGE_FLOW_LLM_TIMEOUT_SECONDS=75
# OPENAI_API_KEY yalnız KNOWLEDGE_FLOW_LLM_API_KEY boşsa yedek olarak okunur.
OPENAI_API_KEY=

AGENT_CORPUS_DIR=data/corpus
# Propose idempotency: processing timeout (saniye); timed-out kayıt otomatik rerun edilmez.
AGENT_SUBMISSION_TIMEOUT_SECONDS=900
